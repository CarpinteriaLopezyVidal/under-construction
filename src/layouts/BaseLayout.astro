---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = 'Carpintería López y Vidal | Ebanistería, Cocinas a Medida y CNC en Alicante',
  description = 'Taller artesanal de carpintería y ebanistería en Pinoso, Alicante. Especialistas en cocinas de diseño, mobiliario a medida, precisión CNC y proyectos integrales para toda España.',
  ogImage = '/gallery/cocina-roble-lujo.jpg',
  canonical = Astro.url.href,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": "https://www.carpinterialopezyvidal.com",
  "name": "Carpintería López y Vidal",
  "legalName": "Carpintería López y Vidal",
  "description": description,
  "url": "https://www.carpinterialopezyvidal.com",
  "telephone": "+34649669311",
  "email": "web@carpinterialopezyvidal.com",
  "image": `https://www.carpinterialopezyvidal.com${ogImage}`,
  "priceRange": "€€ - €€€€",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "09:00",
      "closes": "13:30"
    }
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Polígono Industrial / Pinoso",
    "addressLocality": "Pinoso",
    "addressRegion": "Alicante",
    "postalCode": "03650",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 38.3987,
    "longitude": -1.0339
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Alicante" },
    { "@type": "AdministrativeArea", "name": "Murcia" },
    { "@type": "AdministrativeArea", "name": "Valencia" },
    { "@type": "AdministrativeArea", "name": "Madrid" },
    { "@type": "Country", "name": "España" }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "28"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios de Carpintería y Ebanistería",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cocinas de diseño a medida" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fresado y corte CNC de precisión" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Armarios empotrados y vestidores" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Carpintería artesanal en madera maciza" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Viviendas completas y proyectos de arquitectura" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mobiliario exclusivo y mesas de autor" } }
    ]
  },
  "sameAs": [
    "https://maps.app.goo.gl/ehNcNENWVEACRM6v8"
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary Meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Carpintería López y Vidal" />
  <meta name="robots" content="index, follow" />
  <meta name="keywords" content="carpintería Alicante, ebanistería Pinoso, cocinas a medida Alicante, corte CNC madera, armarios a medida, muebles de diseño en madera, carpintero profesional" />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`https://www.carpinterialopezyvidal.com${ogImage}`} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="Carpintería López y Vidal" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://www.carpinterialopezyvidal.com${ogImage}`} />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Google Fonts — preconnect then load Inter & Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,400&display=swap"
  />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body class="bg-[#FAF7F2] text-stone-900 selection:bg-[#C28E58] selection:text-white">
  <slot />
</body>
</html>
