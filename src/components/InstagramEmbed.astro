---
const instagramHandle = '@carpinterialopezyvidal';
const instagramUrl = 'https://www.instagram.com/';

const workshopShots = [
  {
    title: 'Fresado 3D en Centro de Mecanizado CNC',
    desc: 'Precisión milimétrica sobre madera de roble',
    image: '/gallery/fresado-cnc-madera.jpg',
    tag: 'Tecnología CNC',
  },
  {
    title: 'Ajuste Manual en Banco de Trabajo',
    desc: 'El toque del artesano que ninguna máquina sustituye',
    image: '/gallery/hero-craft.jpg',
    tag: 'Tradición Artesanal',
  },
  {
    title: 'Cocina en Roble Alistonado',
    desc: 'Montaje final y pruebas de herrajes en obra',
    image: '/gallery/cocina-roble-lujo.jpg',
    tag: 'Instalación',
  },
  {
    title: 'Selección de Maderas Nobles',
    desc: 'Nogal americano y roble europeo secados al punto óptimo',
    image: '/gallery/vestidor-nogal-medida.jpg',
    tag: 'Materiales',
  },
];
---

<section id="taller" class="section-pad bg-stone-950 text-white relative overflow-hidden">
  <!-- Subtle wood ring pattern -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#C28E58_1px,transparent_1px)] [background-size:28px_28px]" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="inline-block text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-[#DFB27C] mb-3">
          El Taller por Dentro
        </span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight">
          El Oficio en Acción
        </h2>
        <p class="text-stone-300 text-sm sm:text-base font-light mt-3">
          Desde nuestro taller en Pinoso, Alicante, compartimos el día a día de nuestros proyectos: corte de maderas nobles, programación CNC y ensambles tradicionales.
        </p>
      </div>

      <div class="flex-shrink-0">
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 bg-gradient-to-r from-[#833AB4] via-[#FD1D1D] to-[#FCB045] text-white text-xs sm:text-sm font-semibold px-6 py-3 rounded-xl shadow-lg hover:opacity-90 hover:scale-[1.02] transition-all"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Seguir {instagramHandle}</span>
        </a>
      </div>
    </div>

    <!-- Workshop Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {workshopShots.map((shot) => (
        <div class="group relative rounded-2xl overflow-hidden bg-stone-900 border border-stone-800 shadow-lg aspect-[4/5] flex flex-col justify-end p-5">
          <img
            src={shot.image}
            alt={shot.title}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          />

          <!-- Gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/50 to-transparent"></div>

          <!-- Content on card -->
          <div class="relative z-10">
            <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-[#DFB27C] bg-stone-900/90 border border-stone-700/80 px-2.5 py-0.5 rounded-full mb-2">
              {shot.tag}
            </span>
            <h3 class="font-display font-bold text-base text-white leading-tight mb-1">
              {shot.title}
            </h3>
            <p class="text-xs text-stone-300/80">
              {shot.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

