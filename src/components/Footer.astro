---
const year = new Date().getFullYear();

const footerLinks = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#proceso', label: 'El Método' },
  { href: '#galeria', label: 'Proyectos' },
  { href: '#taller', label: 'Taller & CNC' },
  { href: '#resenas', label: 'Opiniones' },
  { href: '#faq', label: 'Preguntas' },
  { href: '#contacto', label: 'Contacto' },
];

const areasServed = [
  'Pinoso', 'Alicante', 'Elche', 'Elda / Petrer', 'Novelda', 'Villena', 'Murcia', 'Valencia', 'Madrid', 'Ámbito Nacional'
];
---

<footer class="bg-stone-950 text-white border-t border-stone-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 mb-14">

      <!-- Column 1: Brand (5 of 12) -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3.5 mb-5">
          <div
            class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#C28E58] to-[#8C532B] flex items-center justify-center flex-shrink-0 shadow-md"
            aria-hidden="true"
          >
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m0-18l-4 5h8l-4-5zm-5 9l5 4 5-4m-7 5l2 2 2-2" />
            </svg>
          </div>
          <div>
            <p class="font-display font-bold text-lg text-white leading-tight">López & Vidal</p>
            <p class="text-[11px] font-semibold tracking-[0.2em] text-[#DFB27C] uppercase">Ebanistería · CNC</p>
          </div>
        </div>

        <p class="text-stone-400 text-sm leading-relaxed mb-6 font-light">
          Taller de carpintería y ebanistería con más de 30 años de tradición artesanal. Especialistas en cocinas de diseño a medida, vestidores, corte de precisión CNC de 5 ejes y proyectos integrales para viviendas en toda España.
        </p>

        <!-- Social Icons -->
        <div class="flex items-center gap-3" role="list" aria-label="Redes de contacto">
          <a
            href="https://wa.me/34649669311"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp directo"
            class="w-10 h-10 rounded-xl bg-stone-900 border border-stone-800 flex items-center justify-center text-stone-300 hover:text-white hover:bg-[#25D366] hover:border-[#25D366] transition-all shadow-sm"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.559 4.122 1.532 5.852L0 24l6.335-1.51A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.798 9.798 0 01-4.992-1.365l-.358-.213-3.76.896.958-3.658-.235-.376A9.782 9.782 0 012.182 12C2.182 6.578 6.578 2.182 12 2.182S21.818 6.578 21.818 12 17.422 21.818 12 21.818z"/></svg>
          </a>
          <a
            href="https://www.instagram.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-10 h-10 rounded-xl bg-stone-900 border border-stone-800 flex items-center justify-center text-stone-300 hover:text-white hover:bg-[#E1306C] hover:border-[#E1306C] transition-all shadow-sm"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a
            href="https://maps.app.goo.gl/ehNcNENWVEACRM6v8"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ficha en Google Maps"
            class="w-10 h-10 rounded-xl bg-stone-900 border border-stone-800 flex items-center justify-center text-stone-300 hover:text-white hover:bg-[#4285F4] hover:border-[#4285F4] transition-all shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation Links (3 of 12) -->
      <div class="lg:col-span-3">
        <h3 class="font-display font-bold text-white mb-5 uppercase tracking-wider text-xs">
          Navegación
        </h3>
        <ul class="space-y-2.5 text-sm">
          {footerLinks.map(link => (
            <li>
              <a href={link.href} class="text-stone-400 hover:text-[#DFB27C] transition-colors flex items-center gap-2">
                <span class="text-[#C28E58] text-xs">›</span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Contact & Direct info (4 of 12) -->
      <div class="lg:col-span-4">
        <h3 class="font-display font-bold text-white mb-5 uppercase tracking-wider text-xs">
          Taller & Contacto Directo
        </h3>
        <ul class="space-y-3.5 text-sm text-stone-400">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-[#C28E58] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            </svg>
            <span>Pinoso, 03650 Alicante, España</span>
          </li>
          <li>
            <a href="tel:+34649669311" class="flex items-center gap-3 hover:text-white transition-colors">
              <svg class="w-4 h-4 text-[#C28E58] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span>+34 649 669 311</span>
            </a>
          </li>
          <li>
            <a href="mailto:web@carpinterialopezyvidal.com" class="flex items-center gap-3 hover:text-white transition-colors break-all">
              <svg class="w-4 h-4 text-[#C28E58] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span>web@carpinterialopezyvidal.com</span>
            </a>
          </li>
          <li class="flex items-start gap-3 text-xs text-stone-500 pt-1">
            <svg class="w-4 h-4 text-[#C28E58] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Horario: L-V 08:00–18:00 · Sábados con cita previa</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Areas Served (SEO local boost) -->
    <div class="border-t border-stone-900 py-6 text-xs text-stone-500 flex flex-wrap items-center justify-center gap-2">
      <span class="text-stone-400 font-semibold">Zonas de servicio:</span>
      {areasServed.map((area, idx) => (
        <span>
          {area}{idx < areasServed.length - 1 ? ' ·' : ''}
        </span>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-stone-800/80 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>© {year} Carpintería López y Vidal · Todos los derechos reservados · Pinoso, Alicante</p>
      <div class="flex items-center gap-4">
        <span>Aviso Legal</span>
        <span>·</span>
        <span>Política de Privacidad</span>
        <span>·</span>
        <span>Cookies</span>
      </div>
    </div>
  </div>
</footer>
