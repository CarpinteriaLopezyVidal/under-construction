---
const navLinks = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#proceso', label: 'El Método' },
  { href: '#galeria', label: 'Proyectos' },
  { href: '#taller', label: 'Taller & CNC' },
  { href: '#resenas', label: 'Opiniones' },
  { href: '#faq', label: 'Preguntas' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 bg-stone-950/85 backdrop-blur-md border-b border-stone-800/80 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Logo -->
      <a href="#inicio" class="flex items-center gap-3.5 group" aria-label="Carpintería López y Vidal - Inicio">
        <div
          class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#C28E58] to-[#8C532B] flex items-center justify-center flex-shrink-0 shadow-md group-hover:scale-105 transition-transform"
          aria-hidden="true"
        >
          <!-- Elegant woodcraft chisel / tree icon -->
          <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m0-18l-4 5h8l-4-5zm-5 9l5 4 5-4m-7 5l2 2 2-2" />
          </svg>
        </div>
        <div>
          <span class="block font-display font-bold text-white text-base sm:text-lg tracking-wide leading-tight">
            López & Vidal
          </span>
          <span class="block text-[11px] font-medium tracking-[0.2em] text-[#C28E58] uppercase">
            Ebanistería · CNC
          </span>
        </div>
      </a>

      <!-- Desktop navigation -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Navegación principal">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-stone-300 hover:text-white px-3 py-2 text-sm font-medium rounded-lg hover:bg-stone-800/60 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="tel:+34649669311"
          class="hidden xl:flex items-center gap-2 text-stone-300 hover:text-white text-sm font-medium px-3 py-2 rounded-lg hover:bg-stone-800/50 transition-colors"
          title="Llamar directamente"
        >
          <svg class="w-4 h-4 text-[#C28E58]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="tabular-nums">649 669 311</span>
        </a>

        <a
          href="https://wa.me/34649669311?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20presupuesto%20para%20un%20proyecto%20de%20carpinter%C3%ADa"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25D366] text-white px-4 py-2.5 text-sm font-semibold rounded-xl hover:bg-[#20ba5a] transition-all shadow-md shadow-[#25D366]/20 hover:scale-[1.02]"
          aria-label="Contactar por WhatsApp"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.559 4.122 1.532 5.852L0 24l6.335-1.51A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.798 9.798 0 01-4.992-1.365l-.358-.213-3.76.896.958-3.658-.235-.376A9.782 9.782 0 012.182 12C2.182 6.578 6.578 2.182 12 2.182S21.818 6.578 21.818 12 17.422 21.818 12 21.818z"/>
          </svg>
          Presupuesto
        </a>
      </div>

      <!-- Mobile hamburger button -->
      <button
        id="menu-btn"
        type="button"
        class="lg:hidden text-stone-300 hover:text-white p-2.5 rounded-xl bg-stone-900 border border-stone-800 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-stone-800/90 bg-stone-950/95 backdrop-blur-xl px-4 py-5 space-y-1 shadow-2xl"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link block text-stone-200 hover:text-[#C28E58] px-3.5 py-2.5 text-base font-medium rounded-lg hover:bg-stone-900/60 transition-colors"
      >
        {link.label}
      </a>
    ))}

    <div class="pt-4 mt-3 border-t border-stone-800/80 space-y-2">
      <a
        href="tel:+34649669311"
        class="flex items-center justify-center gap-2 text-stone-300 bg-stone-900 py-3 rounded-xl text-sm font-medium border border-stone-800"
      >
        <svg class="w-4 h-4 text-[#C28E58]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Llamar: 649 669 311
      </a>
      <a
        href="https://wa.me/34649669311?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20presupuesto%20para%20un%20proyecto%20de%20carpinter%C3%ADa"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 bg-[#25D366] text-white py-3 rounded-xl text-sm font-semibold shadow-md"
      >
        Pedir Presupuesto por WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });

  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) {
      navbar?.classList.add('bg-stone-950/95', 'shadow-2xl');
      navbar?.classList.remove('bg-stone-950/85');
    } else {
      navbar?.classList.remove('bg-stone-950/95', 'shadow-2xl');
      navbar?.classList.add('bg-stone-950/85');
    }
  });
</script>
