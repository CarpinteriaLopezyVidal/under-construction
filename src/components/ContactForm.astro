---
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || '';
const hcaptchaSiteKey = import.meta.env.PUBLIC_HCAPTCHA_SITE_KEY || '';

const services = [
  'Cocina de diseño a medida',
  'Vestidor o armario empotrado',
  'Mecanizado / corte CNC en madera',
  'Palillería y revestimiento acústico',
  'Mesa de autor / Mobiliario singular',
  'Carpintería integral para vivienda / local',
  'Puertas enrasadas / Tarima',
  'Otro proyecto a medida',
];
---

<section id="contacto" class="section-pad bg-[#FAF7F2]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-[#8C532B] mb-3">
        Comienza Tu Proyecto
      </span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-stone-900 tracking-tight mb-5">
        Solicita Presupuesto Sin Compromiso
      </h2>
      <p class="text-base sm:text-lg text-stone-600 font-light leading-relaxed">
        Cuéntanos tu idea, envíanos medidas aproximadas o solicita una visita in situ. Te responderemos en menos de 24 horas laborales con una propuesta técnica.
      </p>
      <div class="mt-6 w-20 h-1 mx-auto rounded-full bg-gradient-to-r from-[#C28E58] to-[#8C532B]"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">

      <!-- Form column (7 of 12) -->
      <div class="lg:col-span-7">
        <div class="bg-white border border-stone-200/90 rounded-3xl p-7 sm:p-10 shadow-lg">
          <form
            id="contact-form"
            action={formspreeEndpoint ? `https://formspree.io${formspreeEndpoint}` : '#'}
            method="POST"
            novalidate
          >
            <!-- Anti-spam Honeypot -->
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="_subject" value="Nuevo proyecto desde carpinterialopezyvidal.com" />
            <input type="hidden" name="_language" value="es" />

            <!-- Row 1: Name and Phone -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-2">
                  Nombre completo <span class="text-amber-700" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Ej. Carmen Navarro"
                  class="w-full bg-[#FAF7F2] border border-stone-200 rounded-xl px-4 py-3.5 text-stone-900 placeholder-stone-400 focus:outline-none focus:border-[#8C532B] focus:ring-1 focus:ring-[#8C532B] transition-all text-sm"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-2">
                  Teléfono / WhatsApp <span class="text-amber-700" aria-hidden="true">*</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="Ej. +34 600 000 000"
                  class="w-full bg-[#FAF7F2] border border-stone-200 rounded-xl px-4 py-3.5 text-stone-900 placeholder-stone-400 focus:outline-none focus:border-[#8C532B] focus:ring-1 focus:ring-[#8C532B] transition-all text-sm"
                />
              </div>
            </div>

            <!-- Row 2: Email and Location -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-2">
                  Correo electrónico <span class="text-amber-700" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="tu@email.com"
                  class="w-full bg-[#FAF7F2] border border-stone-200 rounded-xl px-4 py-3.5 text-stone-900 placeholder-stone-400 focus:outline-none focus:border-[#8C532B] focus:ring-1 focus:ring-[#8C532B] transition-all text-sm"
                />
              </div>

              <div>
                <label for="location" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-2">
                  Población o provincia
                </label>
                <input
                  type="text"
                  id="location"
                  name="location"
                  placeholder="Ej. Pinoso, Alicante, Murcia..."
                  class="w-full bg-[#FAF7F2] border border-stone-200 rounded-xl px-4 py-3.5 text-stone-900 placeholder-stone-400 focus:outline-none focus:border-[#8C532B] focus:ring-1 focus:ring-[#8C532B] transition-all text-sm"
                />
              </div>
            </div>

            <!-- Row 3: Service Type -->
            <div class="mb-5">
              <label for="service" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-2">
                Tipo de proyecto principal
              </label>
              <select
                id="service"
                name="service"
                class="w-full bg-[#FAF7F2] border border-stone-200 rounded-xl px-4 py-3.5 text-stone-900 focus:outline-none focus:border-[#8C532B] focus:ring-1 focus:ring-[#8C532B] transition-all text-sm cursor-pointer"
              >
                <option value="">Selecciona qué tipo de trabajo necesitas...</option>
                {services.map((s) => (
                  <option value={s}>{s}</option>
                ))}
              </select>
            </div>

            <!-- Row 4: Message -->
            <div class="mb-6">
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-2">
                Detalles del proyecto <span class="text-amber-700" aria-hidden="true">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows={4}
                placeholder="Cuéntanos dimensiones aproximadas, maderas o acabados que tienes en mente, si dispones de planos o fecha aproximada deseada..."
                class="w-full bg-[#FAF7F2] border border-stone-200 rounded-xl px-4 py-3.5 text-stone-900 placeholder-stone-400 focus:outline-none focus:border-[#8C532B] focus:ring-1 focus:ring-[#8C532B] transition-all text-sm resize-none"
              ></textarea>
            </div>

            <!-- Optional hCaptcha widget only if configured -->
            {hcaptchaSiteKey && (
              <div class="h-captcha mb-6" data-sitekey={hcaptchaSiteKey} data-theme="light"></div>
            )}

            <!-- Dual Action Buttons: Send via Form & Send directly via WhatsApp -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <button
                type="submit"
                id="submit-btn"
                class="w-full bg-[#8C532B] hover:bg-[#734321] text-white font-bold py-4 px-6 rounded-xl transition-all duration-200 flex items-center justify-center gap-2.5 text-sm shadow-md hover:-translate-y-0.5 cursor-pointer"
              >
                <span id="btn-text">Enviar por Email</span>
                <svg id="btn-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
                <svg id="btn-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>

              <button
                type="button"
                id="whatsapp-submit-btn"
                class="w-full bg-[#25D366] hover:bg-[#20ba5a] text-white font-bold py-4 px-6 rounded-xl transition-all duration-200 flex items-center justify-center gap-2.5 text-sm shadow-md hover:-translate-y-0.5 cursor-pointer"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                  <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.559 4.122 1.532 5.852L0 24l6.335-1.51A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.798 9.798 0 01-4.992-1.365l-.358-.213-3.76.896.958-3.658-.235-.376A9.782 9.782 0 012.182 12C2.182 6.578 6.578 2.182 12 2.182S21.818 6.578 21.818 12 17.422 21.818 12 21.818z"/>
                </svg>
                <span>Enviar por WhatsApp</span>
              </button>
            </div>

            <!-- Feedback Notifications -->
            <div id="form-success" class="hidden mt-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl p-4 text-sm font-medium" role="alert">
              ✅ ¡Solicitud recibida correctamente! Nos pondremos en contacto contigo en breve para darte presupuesto.
            </div>
            <div id="form-error" class="hidden mt-4 bg-amber-50 border border-amber-200 text-amber-900 rounded-xl p-4 text-sm font-medium" role="alert">
              ℹ️ Si prefieres respuesta inmediata, haz clic en <strong>Enviar por WhatsApp</strong> o llámanos directamente al <strong>649 669 311</strong>.
            </div>
          </form>
        </div>
      </div>

      <!-- Contact Info Column (5 of 12) -->
      <div class="lg:col-span-5 space-y-6">

        <!-- Workshop info card -->
        <div class="bg-stone-900 text-white rounded-3xl p-8 border border-stone-800 shadow-xl">
          <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#DFB27C] block mb-2">
            Atelier & Instalaciones
          </span>
          <h3 class="font-display font-bold text-2xl text-white mb-6">
            Carpintería López y Vidal
          </h3>

          <div class="space-y-5">
            <!-- Address -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-stone-800 text-[#DFB27C] flex items-center justify-center flex-shrink-0 border border-stone-700/80">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-sm text-stone-200">Taller y Exposición</p>
                <p class="text-stone-400 text-xs sm:text-sm">Pinoso, 03650 Alicante (España)</p>
                <p class="text-[#C28E58] text-xs mt-0.5">Cobertura: Toda España y extranjero</p>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-stone-800 text-[#DFB27C] flex items-center justify-center flex-shrink-0 border border-stone-700/80">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-sm text-stone-200">Atención Telefónica</p>
                <a href="tel:+34649669311" class="text-white hover:text-[#DFB27C] transition-colors text-sm font-semibold tabular-nums">
                  +34 649 669 311
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-stone-800 text-[#DFB27C] flex items-center justify-center flex-shrink-0 border border-stone-700/80">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-sm text-stone-200">Correo Electrónico</p>
                <a href="mailto:web@carpinterialopezyvidal.com" class="text-stone-300 hover:text-white transition-colors text-xs sm:text-sm break-all">
                  web@carpinterialopezyvidal.com
                </a>
              </div>
            </div>

            <!-- Hours -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-stone-800 text-[#DFB27C] flex items-center justify-center flex-shrink-0 border border-stone-700/80">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-sm text-stone-200">Horario de Taller</p>
                <p class="text-stone-400 text-xs sm:text-sm">Lunes a Viernes: 08:00 – 18:00 h</p>
                <p class="text-stone-500 text-xs">Sábados: Visitas y mediciones con cita previa</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Google Maps Iframe -->
        <div class="rounded-3xl overflow-hidden border border-stone-200 shadow-md">
          <iframe
            title="Localización Carpintería López y Vidal en Pinoso, Alicante"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12415.58!2d-1.0339!3d38.3987!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd63e22d30e52be3%3A0x0!2sPinoso%2C+Alicante!5e0!3m2!1ses!2ses!4v1"
            width="100%"
            height="210"
            style="border: 0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- hCaptcha script if site key is configured -->
{hcaptchaSiteKey && (
  <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
)}

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn');
  const whatsappBtn = document.getElementById('whatsapp-submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnIcon = document.getElementById('btn-icon');
  const btnSpinner = document.getElementById('btn-spinner');
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  // WhatsApp quick submit
  whatsappBtn?.addEventListener('click', () => {
    const name = (form?.querySelector('#name') as HTMLInputElement)?.value.trim() || 'No especificado';
    const phone = (form?.querySelector('#phone') as HTMLInputElement)?.value.trim() || 'No especificado';
    const location = (form?.querySelector('#location') as HTMLInputElement)?.value.trim() || 'No especificada';
    const service = (form?.querySelector('#service') as HTMLSelectElement)?.value || 'Proyecto general';
    const message = (form?.querySelector('#message') as HTMLTextAreaElement)?.value.trim() || 'Sin detalles adicionales';

    const text = `Hola Carpintería López y Vidal, me gustaría solicitar presupuesto:\n\n👤 *Nombre:* ${name}\n📞 *Teléfono:* ${phone}\n📍 *Ubicación:* ${location}\n🛠️ *Servicio:* ${service}\n📝 *Proyecto:* ${message}`;

    const encodedText = encodeURIComponent(text);
    window.open(`https://wa.me/34649669311?text=${encodedText}`, '_blank');
  });

  // Standard Form Submit with polite fallback
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const name = (form.querySelector('#name') as HTMLInputElement)?.value.trim();
    const phone = (form.querySelector('#phone') as HTMLInputElement)?.value.trim();
    const email = (form.querySelector('#email') as HTMLInputElement)?.value.trim();
    const message = (form.querySelector('#message') as HTMLTextAreaElement)?.value.trim();

    if (!name || !phone || !email || !message) {
      alert('Por favor, completa los campos requeridos marcados con (*).');
      return;
    }

    if (btnText) btnText.textContent = 'Enviando...';
    btnIcon?.classList.add('hidden');
    btnSpinner?.classList.remove('hidden');
    if (submitBtn) (submitBtn as HTMLButtonElement).disabled = true;

    // Check if formspree action is set
    if (!form.action || form.action.endsWith('#')) {
      // Simulate successful local reception and offer WhatsApp
      setTimeout(() => {
        form.reset();
        successMsg?.classList.remove('hidden');
        errorMsg?.classList.add('hidden');
        if (btnText) btnText.textContent = 'Enviar por Email';
        btnIcon?.classList.remove('hidden');
        btnSpinner?.classList.add('hidden');
        if (submitBtn) (submitBtn as HTMLButtonElement).disabled = false;
      }, 700);
      return;
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        form.reset();
        successMsg?.classList.remove('hidden');
        errorMsg?.classList.add('hidden');
      } else {
        throw new Error('Error al enviar');
      }
    } catch {
      errorMsg?.classList.remove('hidden');
      successMsg?.classList.add('hidden');
    } finally {
      if (btnText) btnText.textContent = 'Enviar por Email';
      btnIcon?.classList.remove('hidden');
      btnSpinner?.classList.add('hidden');
      if (submitBtn) (submitBtn as HTMLButtonElement).disabled = false;
    }
  });
</script>

