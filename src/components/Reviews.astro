---
interface Review {
  name: string;
  role: string;
  project: string;
  rating: number;
  date: string;
  text: string;
  avatar: string;
}

const reviews: Review[] = [
  {
    name: 'María García',
    role: 'Propietaria de vivienda en Alicante',
    project: 'Cocina a medida en roble con isla central',
    rating: 5,
    date: 'Hace 2 semanas',
    text: 'Un trabajo sencillamente espectacular. Nos hicieron la cocina completa en roble alistonado y el resultado superó todas las expectativas. Puntuales, limpios en el montaje y con unos herrajes y acabados de primera.',
    avatar: 'MG',
  },
  {
    name: 'Carlos Martínez',
    role: 'Cliente particular en Elche',
    project: 'Vestidor en nogal y armarios empotrados',
    rating: 5,
    date: 'Hace 1 mes',
    text: 'Contraté a López y Vidal para un vestidor a medida en madera de nogal con vitrinas e iluminación integrada. La atención al detalle, los cortes a inglete y el ajuste a las paredes fueron impecables.',
    avatar: 'CM',
  },
  {
    name: 'Ana Pérez',
    role: 'Arquitecta de interiores en Valencia',
    project: 'Carpintería integral de chalet: puertas y tarima',
    rating: 5,
    date: 'Hace 2 meses',
    text: 'Como profesional de la arquitectura, soy muy exigente con las tolerancias y los acabados. Trabajar con López y Vidal es garantía absoluta de éxito: entienden los planos al milímetro y cumplen los plazos pactados.',
    avatar: 'AP',
  },
  {
    name: 'José Luis Sánchez',
    role: 'Diseñador en Murcia',
    project: 'Mecanizado CNC 5 ejes para celosía arquitectónica',
    rating: 5,
    date: 'Hace 3 meses',
    text: 'Les envié los archivos CAD para unas celosías tridimensionales complejas en madera maciza. La precisión del corte CNC y el lijado final a mano fueron insuperables. Grandes maestros ebanistas.',
    avatar: 'JS',
  },
  {
    name: 'Elena Ramos',
    role: 'Cliente particular en Pinoso',
    project: 'Muebles de baño hidrófugos y mesa comedor',
    rating: 5,
    date: 'Hace 4 meses',
    text: 'Buscábamos una mesa de roble macizo con cantos naturales del árbol y nos la hicieron a medida. Se nota la pasión y los más de 30 años de experiencia que tienen con la madera. Trato cercano y profesional.',
    avatar: 'ER',
  },
  {
    name: 'David Navarro',
    role: 'Reforma integral en Elda',
    project: 'Revestimiento de palillería acústica y puertas',
    rating: 5,
    date: 'Hace 5 meses',
    text: 'Instalaron un panelado de listones de madera en el salón con puertas ocultas enrasadas. El aislamiento acústico y la calidez que le ha dado a la casa es increíble. Recomendables al 100%.',
    avatar: 'DN',
  },
];
---

<section id="resenas" class="section-pad bg-[#FAF7F2]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-block text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-[#8C532B] mb-3">
        Confianza & Satisfacción
      </span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-stone-900 tracking-tight mb-5">
        Lo que Dicen Nuestros Clientes
      </h2>
      <p class="text-base sm:text-lg text-stone-600 font-light leading-relaxed">
        La mayor satisfacción es el resultado perdurable en los hogares y proyectos de quienes confían en nosotros.
      </p>

      <!-- Google Official Rating Badge -->
      <div class="mt-8 inline-flex items-center gap-4 bg-white border border-stone-200/90 rounded-2xl px-6 py-3.5 shadow-sm">
        <svg class="w-7 h-7 flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>

        <div class="text-left">
          <div class="flex items-center gap-1.5">
            <span class="font-bold text-stone-900 text-lg">5.0</span>
            <div class="flex text-amber-500" aria-label="5 de 5 estrellas">
              {[1, 2, 3, 4, 5].map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
          </div>
          <p class="text-xs text-stone-500">
            Opiniones verificadas en Google Maps
          </p>
        </div>

        <a
          href="https://maps.app.goo.gl/ehNcNENWVEACRM6v8"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 text-xs font-bold text-[#8C532B] hover:text-[#C28E58] border border-stone-200 hover:border-[#8C532B] px-3 py-1.5 rounded-lg transition-colors"
        >
          Ver en Google →
        </a>
      </div>

      <div class="mt-8 w-20 h-1 mx-auto rounded-full bg-gradient-to-r from-[#C28E58] to-[#8C532B]"></div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((review) => (
        <article class="bg-white border border-stone-200/90 rounded-3xl p-7 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <!-- Rating stars and verified badge -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex text-amber-500" aria-label={`${review.rating} de 5 estrellas`}>
                {Array.from({ length: review.rating }).map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>

              <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Verificada
              </span>
            </div>

            <!-- Project Tag -->
            <p class="text-xs font-semibold uppercase tracking-wider text-[#8C532B] mb-3">
              {review.project}
            </p>

            <!-- Review quote -->
            <blockquote class="text-stone-700 text-sm leading-relaxed mb-6 font-normal">
              "{review.text}"
            </blockquote>
          </div>

          <!-- Author info -->
          <div class="pt-4 border-t border-stone-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 rounded-full bg-gradient-to-br from-[#C28E58] to-[#8C532B] text-white text-xs font-bold flex items-center justify-center flex-shrink-0 shadow-sm"
                aria-hidden="true"
              >
                {review.avatar}
              </div>
              <div>
                <p class="font-bold text-stone-900 text-sm">{review.name}</p>
                <p class="text-[11px] text-stone-500">{review.role}</p>
              </div>
            </div>
            <span class="text-[11px] text-stone-400">{review.date}</span>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA to Google Maps -->
    <div class="mt-12 text-center">
      <a
        href="https://maps.app.goo.gl/ehNcNENWVEACRM6v8"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-white border border-stone-300 hover:border-[#8C532B] text-stone-800 hover:text-[#8C532B] font-semibold px-6 py-3 rounded-full text-xs sm:text-sm transition-all shadow-sm"
      >
        <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span>Escribir una reseña o ver ficha completa en Google Maps</span>
      </a>
    </div>

  </div>
</section>

