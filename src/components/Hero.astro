---
---

<section
  id="inicio"
  class="relative min-h-[92vh] flex items-center justify-center overflow-hidden pt-24 pb-16 lg:py-32"
>
  <!-- Background image layer with new high-res artisan photography -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat scale-105 transition-transform duration-1000"
    style="background-image: url('/gallery/hero-craft.jpg');"
    aria-hidden="true"
  ></div>

  <!-- Warm Dark Wood Atmospheric Overlay -->
  <div class="absolute inset-0 bg-gradient-to-r from-stone-950/95 via-stone-950/80 to-stone-900/65" aria-hidden="true"></div>

  <!-- Subtle wood texture grid -->
  <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#C28E58_1px,transparent_1px)] [background-size:32px_32px]" aria-hidden="true"></div>

  <!-- Content Container -->
  <div class="relative z-10 text-center text-white px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">

    <!-- Location & Trust Pill -->
    <div class="inline-flex items-center gap-2.5 bg-stone-900/80 backdrop-blur-md border border-[#C28E58]/35 text-stone-200 text-xs sm:text-sm font-medium px-4 py-1.5 rounded-full mb-8 shadow-lg">
      <span class="flex h-2 w-2 rounded-full bg-[#C28E58] animate-pulse"></span>
      <span class="text-[#DFB27C] font-semibold">Taller Propio en Pinoso, Alicante</span>
      <span class="text-stone-400">·</span>
      <span class="text-stone-300">Servicio en Toda España y Europa</span>
    </div>

    <!-- Main Heading -->
    <h1 class="font-display font-extrabold text-4xl sm:text-6xl lg:text-7xl leading-[1.12] mb-6 tracking-tight text-white">
      Ebanistería Artesanal<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#E5BE8A] via-[#C28E58] to-[#9E6534]">
        y Precisión CNC
      </span>
    </h1>

    <!-- Value Proposition Tagline -->
    <p class="text-lg sm:text-2xl text-stone-200 max-w-3xl mx-auto mb-5 leading-relaxed font-light">
      Damos forma a la madera más noble para crear <strong class="text-white font-semibold">espacios a medida</strong> que aúnan la calidez del trabajo manual y la exactitud tecnológica.
    </p>

    <p class="text-sm sm:text-base text-stone-300/80 max-w-2xl mx-auto mb-10 leading-relaxed">
      Cocinas de alta gama, vestidores personalizados, revestimientos arquitectónicos y mobiliario singular. Cuidamos cada detalle desde el primer boceto hasta la instalación final.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href="#contacto"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-[#C28E58] to-[#A36C38] hover:from-[#d19c64] hover:to-[#b07842] text-white font-bold px-8 py-4 rounded-xl text-base shadow-xl shadow-amber-950/40 hover:-translate-y-0.5 transition-all duration-200"
      >
        <svg class="w-5 h-5 text-amber-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        <span>Solicitar Presupuesto Gratuito</span>
      </a>

      <a
        href="#galeria"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-stone-900/70 hover:bg-stone-800/80 backdrop-blur-md border border-stone-700/80 hover:border-[#C28E58]/60 text-stone-200 hover:text-white font-semibold px-7 py-4 rounded-xl text-base transition-all duration-200 hover:-translate-y-0.5"
      >
        <svg class="w-5 h-5 text-[#C28E58]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span>Explorar Catálogo</span>
      </a>
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto">
      {[
        { value: '+30 Años', label: 'Maestría y Tradición Familiar' },
        { value: '100% Medida', label: 'Proyectos Únicos Sin Límites' },
        { value: 'Control CNC', label: 'Fresado y Corte Milimétrico' },
        { value: '5.0 ★ Google', label: 'Opiniones 100% Satisfechas' },
      ].map(({ value, label }) => (
        <div class="bg-stone-900/60 backdrop-blur-md border border-stone-800/80 rounded-2xl p-4 text-center hover:border-[#C28E58]/40 transition-colors">
          <div class="text-xl sm:text-2xl font-bold font-display text-[#DFB27C]">{value}</div>
          <div class="text-xs text-stone-300 mt-1">{label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll Down Indicator -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 animate-bounce hidden sm:block" aria-hidden="true">
    <a href="#servicios" aria-label="Ver servicios" class="text-stone-400 hover:text-white transition-colors">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </a>
  </div>
</section>

