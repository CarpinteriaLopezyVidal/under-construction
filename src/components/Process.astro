---
const steps = [
  {
    number: '01',
    title: 'Asesoramiento & Medición',
    tagline: 'Definimos tu visión',
    description:
      'Nos reunimos contigo o analizamos los planos de tu arquitecto/interiorista. Visitamos la estancia en Alicante, Murcia o cualquier punto de España para tomar medidas milimétricas e identificar peculiaridades de la obra.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>`,
  },
  {
    number: '02',
    title: 'Diseño 3D & Muestrario de Maderas',
    tagline: 'Visualiza antes de fabricar',
    description:
      'Modelamos tu proyecto en 3D para que veas proporciones, distribución e iluminación. Ponemos en tus manos muestras reales de maderas nobles (roble, nogal, fresno, iroko) y catálogo de herrajes de gama alta (Blum / Grass).',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>`,
  },
  {
    number: '03',
    title: 'Fabricación Artesanal & Corte CNC',
    tagline: 'Precisión milimétrica en taller',
    description:
      'Fabricamos cada pieza en nuestras instalaciones de Pinoso. Combinamos la tecnología de mecanizado CNC de 5 ejes para cortes de tolerancia cero con la tradición del ensamblado, encolado y acabado a mano.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
  },
  {
    number: '04',
    title: 'Transporte & Montaje Impecable',
    tagline: 'Instalación limpia y garantizada',
    description:
      'Nuestro propio equipo de maestros carpinteros se encarga del traslado e instalación en destino. Cuidamos cada encuentro con paredes y suelos, sellamos juntas a la perfección y dejamos la estancia limpia y lista para disfrutar.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`,
  },
];
---

<section id="proceso" class="section-pad bg-stone-900 text-white relative overflow-hidden">
  <!-- Subtle wood ring pattern -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#C28E58_1px,transparent_1px)] [background-size:24px_24px]" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-[#DFB27C] mb-3">
        Garantía y Tranquilidad
      </span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight mb-5">
        Nuestro Método de Trabajo
      </h2>
      <p class="text-base sm:text-lg text-stone-300 font-light leading-relaxed">
        Un proceso transparente y riguroso desde la primera toma de contacto hasta la entrega de llaves. Sin sorpresas ni desviaciones de presupuesto.
      </p>
      <div class="mt-6 w-20 h-1 mx-auto rounded-full bg-gradient-to-r from-[#C28E58] to-[#8C532B]"></div>
    </div>

    <!-- Steps Timeline Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {steps.map((step) => (
        <div class="bg-stone-950/70 border border-stone-800 rounded-3xl p-7 relative hover:border-[#C28E58]/50 transition-all duration-300 flex flex-col justify-between group">
          <!-- Step Number Badge -->
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-display font-black text-3xl text-[#C28E58]/40 group-hover:text-[#C28E58] transition-colors">
                {step.number}
              </span>
              <div class="w-11 h-11 rounded-xl bg-stone-900 border border-stone-800 flex items-center justify-center text-[#DFB27C] group-hover:scale-110 transition-transform">
                <Fragment set:html={step.icon} />
              </div>
            </div>

            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#DFB27C] block mb-1.5">
              {step.tagline}
            </span>

            <h3 class="font-display font-bold text-xl text-white mb-3">
              {step.title}
            </h3>

            <p class="text-stone-400 text-xs sm:text-sm leading-relaxed">
              {step.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-stone-800/80 flex items-center gap-2 text-xs text-stone-400">
            <span class="w-1.5 h-1.5 rounded-full bg-[#C28E58]"></span>
            <span>Compromiso López y Vidal</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Guarantees Bar -->
    <div class="mt-14 bg-stone-950/90 border border-stone-800 rounded-2xl p-6 sm:p-8 grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      <div class="flex items-center justify-center gap-3">
        <svg class="w-6 h-6 text-[#C28E58] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span class="text-xs sm:text-sm text-stone-300 font-medium">Garantía por escrito en estructura y herrajes</span>
      </div>
      <div class="flex items-center justify-center gap-3 border-y sm:border-y-0 sm:border-x border-stone-800 py-3 sm:py-0">
        <svg class="w-6 h-6 text-[#C28E58] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-xs sm:text-sm text-stone-300 font-medium">Plazos de entrega y montaje pactados por contrato</span>
      </div>
      <div class="flex items-center justify-center gap-3">
        <svg class="w-6 h-6 text-[#C28E58] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
        </svg>
        <span class="text-xs sm:text-sm text-stone-300 font-medium">Maderas nobles de gestión forestal sostenible</span>
      </div>
    </div>

  </div>
</section>
